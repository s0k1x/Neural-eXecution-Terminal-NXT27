{
  "name": "nxt27-terminal",
  "productName": "NXT27",
  "version": "2.1.0",
  "description": "Neural eXecution Terminal — real desktop terminal with NXT27 skin",
  "main": "main.js",
  "author": "s0k1x",
  "license": "MIT",
  "repository": "https://github.com/s0k1x/Neural-eXecution-Terminal-NXT27",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.nxt27.terminal",
    "productName": "NXT27",
    "asar": false,
    "npmRebuild": false,
    "files": ["**/*"],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NXT27-Setup-${version}.${ext}"
    }
  }
}
